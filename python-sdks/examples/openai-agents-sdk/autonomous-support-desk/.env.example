# Copy to .env and fill in your key:  cp .env.example .env

# Respan API key - https://platform.respan.ai/settings/api-keys
# The gateway account needs credits (or a provider key) and these models enabled:
#   gpt-4.1-nano, gpt-4.1-mini, text-embedding-3-small
RESPAN_API_KEY=

# Optional - defaults to https://api.respan.ai/api
# RESPAN_BASE_URL=https://api.respan.ai/api
