# Copy to .env and fill in your keys:  cp .env.example .env

# Respan API key - https://platform.respan.ai/settings/api-keys
# Used for the traces, and for the browser-use scenario's model calls (through the Respan gateway).
RESPAN_API_KEY=

# Kernel API key - https://dashboard.onkernel.com (not needed with `run_all.py --fake`)
KERNEL_API_KEY=

# Optional
# RESPAN_BASE_URL=https://api.respan.ai/api
# RESPAN_PLATFORM_URL=https://platform.respan.ai     # used for the links run_all.py prints
# RESPAN_MODEL=gpt-4.1-mini                          # the browser-use scenario's model
# KERNEL_TARGET_URL=https://example.com              # the public page live scenarios open
# KERNEL_PROBE_PASSWORDS=1                           # or run_all.py --probe-passwords
