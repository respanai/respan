{
  "name": "@respan/instrumentation-n8n",
  "type": "module",
  "version": "0.1.0",
  "description": "Respan instrumentation for n8n native OpenTelemetry workflow and agent spans",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js",
      "default": "./dist/register.js"
    }
  },
  "author": "Respan <team@respan.ai>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/respanai/respan",
    "directory": "javascript-sdks/instrumentations/respan-instrumentation-n8n"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc -p tsconfig.json && node --test tests/*.test.mjs",
    "publish:package": "yarn npm publish",
    "release": "yarn build && yarn version patch && yarn publish:package"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/instrumentation": ">=0.213.0 <0.222.0",
    "@opentelemetry/sdk-trace-base": ">=2.6.0 <2.11.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@respan/respan-sdk": "^1.1.7",
    "@respan/tracing": "workspace:^",
    "@traceloop/ai-semantic-conventions": "^0.13.0"
  },
  "peerDependencies": {
    "n8n": ">=2.19.0 <2.38.0"
  },
  "peerDependenciesMeta": {
    "n8n": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/resources": ">=2.10.0 <2.11.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@types/node": "^24.10.1",
    "typescript": "^5.7.3"
  }
}
