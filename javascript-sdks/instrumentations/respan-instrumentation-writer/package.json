{
  "name": "@respan/instrumentation-writer",
  "type": "module",
  "version": "0.1.0",
  "description": "Respan instrumentation plugin for Writer TypeScript SDK",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "Respan <team@respan.ai>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/respanai/respan",
    "directory": "javascript-sdks/instrumentations/respan-instrumentation-writer"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
