    "@traceloop/ai-semantic-conventions": "^0.13.0"
  },
  "peerDependencies": {
    "writer-sdk": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "writer-sdk": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "typescript": "^5.7.3",
    "writer-sdk": "^2.3.2",
