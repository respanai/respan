    "@ai-sdk/provider": "4.0.26",
    "@ai-sdk/provider-utils": "5.0.58"
  },
  "peerDependencies": {
    "ai": ">=7.0.0 <8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "ai": "^7.0.136",
    "typescript": "^5.7.3"
  }
}
