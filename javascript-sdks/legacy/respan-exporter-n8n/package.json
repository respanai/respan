{
	"name": "@respan/n8n-nodes-respan",
	"version": "1.0.0",
	"packageManager": "yarn@4.9.2",
	"description": "Respan Exporter for n8n",
	"license": "MIT",
	"homepage": "https://respan.ai",
	"keywords": [
		"n8n-community-node-package",
		"respan",
		"llm",
		"ai"
	],
	"author": {
		"name": "Respan",
		"email": "team@respan.ai"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/respanai/respan",
		"directory": "javascript-sdks/legacy/respan-exporter-n8n"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"credentials",
		"nodes",
		"icons"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/RespanApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Respan/Respan.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.42.1",
		"eslint": "9.29.0",
		"n8n-workflow": "^2.33.1",
		"prettier": "3.6.2",
		"release-it": "^21.0.1",
		"typescript": "5.9.2",
		"zod": "^3.25.76"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"resolutions": {
		"nanoid": "3.3.18",
		"uuid": "11.1.1"
	}
}
