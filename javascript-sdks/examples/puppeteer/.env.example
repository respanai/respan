# Copy to .env and fill in your key:  cp .env.example .env

# Respan API key - https://platform.respan.ai/settings/api-keys
# Used for the traces, and for the model calls of the LLM scenario (through the Respan gateway).
RESPAN_API_KEY=

# Optional
# RESPAN_BASE_URL=https://api.respan.ai/api
# RESPAN_PLATFORM_URL=https://platform.respan.ai     # used for the links verify_live.py prints
# RESPAN_MODEL=gpt-4.1-mini                          # the LLM scenario's model
# CHROME_PATH=/usr/bin/google-chrome                 # default: the installed Google Chrome
# HEADED=1                                           # show the browser windows
